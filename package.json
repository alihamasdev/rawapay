{
	"name": "rawapay",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.7",
			"typescript": "^6.0.3",
			"@types/node": "^26.6.5",
			"lucide-react": "^1.48.0",
			"react": "^19.3.0",
			"react-dom": "^19.3.0",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "oxlint --fix && oxfmt --write",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"dev:web": "turbo run dev -F web --"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rawapay/config": "workspace:*",
		"@types/bun": "^1.4.3",
		"@types/node": "catalog:",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"turbo": "^2.11.10",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
