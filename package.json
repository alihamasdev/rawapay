{
	"name": "rawapay",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.5",
			"typescript": "^6.0.3",
			"@types/node": "^26.6.2",
			"varlock": "1.20.0",
			"lucide-react": "^1.48.0",
			"react": "^19.3.0",
			"react-dom": "^19.3.0",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"env:generate": "varlock codegen --path ./apps/web/",
		"postinstall": "varlock codegen --path ./apps/web/",
		"check": "oxlint && oxfmt --write"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rawapay/config": "workspace:*",
		"@types/bun": "^1.4.2",
		"@types/node": "catalog:",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"packageManager": "bun@1.3.14"
}
